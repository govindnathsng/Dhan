# Copy to .env (gitignored) or export in your shell. NEVER commit real values.
# The app reads these only from the environment; it never prints their values.

# Live account (used only in Phase 5, only on your own machine with a registered static IP)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Dhan sandbox (developer.dhanhq.co) for API plumbing tests only
DHAN_SANDBOX_CLIENT_ID=
DHAN_SANDBOX_ACCESS_TOKEN=

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live gate step (b): must be exactly "true" to even consider live mode. Leave empty.
DHAN_LIVE_ENABLED=
