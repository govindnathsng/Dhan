# Copy to .env (gitignored) or export in your shell. NEVER commit real values.
# The app reads these only from the environment; it never prints their values.

# --- LIVE HOST ONLY (your Mac with ISP static IP, or an Indian VPS). NEVER set these in the cloud. ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Live gate step (b): must be exactly "true" to even consider live mode. Leave empty.
DHAN_LIVE_ENABLED=

# --- Cloud paper loop (optional): a token used for DATA endpoints only ---
DHAN_DATA_CLIENT_ID=
DHAN_DATA_ACCESS_TOKEN=

# --- Dhan sandbox (developer.dhanhq.co), opt-in plumbing tests only ---
DHAN_SANDBOX_CLIENT_ID=
DHAN_SANDBOX_ACCESS_TOKEN=

# --- Telegram alerts and approvals (optional in paper) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
